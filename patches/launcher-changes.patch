             // A single row never shows the names under its tiles (the title above the row names the app), so the
             // 7dp gap and 22dp label item_app.xml keeps for them would only lift the row: sit it that much lower.
             if (singleRow && !cfg.alwaysShowNames) want += (int) (29 * density);
+            // The next row starts BOTTOM_ROOM_DP above the bottom edge, which is the peek under the dock. Sit the dock
+            // that much lower so the next row only shows once you press Down. Both the room and the grid height scale
+            // with the screen, so this holds on any TV; on a screen too short for it, the dock stops 8dp short of the
+            // bottom edge instead of running off it.
+            if (rowsBelowDock == 0 && MainActivity.this.dockRow && !singleRow) {
+                int lower = (int) (AppAdapter.BOTTOM_ROOM_DP * density);
+                int limit = Math.max(want, h - dockRow - (int) (8 * density));
+                want = Math.min(want + lower, limit);
+            }
             if (grid.getPaddingTop() != want) {
                 grid.setPadding(grid.getPaddingLeft(), want, grid.getPaddingRight(), grid.getPaddingBottom());
                 // A vertical grid parks the dock on the new padding line by scrolling (onTileFocused); a sideways
@@ -1995,6 +2004,11 @@
     /** The shelf's text for this dock app: its name and, on the cinematic shelf, "Last opened" and the dots. */
     private void fillHero(int position, String label) {
         heroName.setText(label);
+        // The name takes the app's own colour (Netflix red, Prime blue), lifted 35% toward white to stay readable.
+        int accent = adapter.ambientColorAt(position);
+        int r = ((accent >> 16) & 0xFF), g = ((accent >> 8) & 0xFF), b = (accent & 0xFF);
+        heroName.setTextColor(0xFF000000 | ((r + (255 - r) * 35 / 100) << 16) | ((g + (255 - g) * 35 / 100) << 8)
+                | (b + (255 - b) * 35 / 100));
         if (!cinematic) return;
         updateHeroMeta(position);
         updateHeroDots(position);
